# Base URL of the backend API (no trailing slash).
# The SPA's typed fetch client prefixes all requests with this value, e.g.
# `${VITE_API_BASE_URL}/api/v1/...`.
#
# Local dev (api running on its default port, see api/.env.example for PORT):
VITE_API_BASE_URL=http://localhost:3000

# Note: only variables prefixed with VITE_ are exposed to client-side code
# (Vite convention) — never put secrets here. Auth uses HttpOnly session
# cookies set by the API, not tokens read/stored in JS (architecture.md §10.4 / §12).
