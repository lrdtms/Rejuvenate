{
  "name": "@rejuvenate/api",
  "version": "0.1.0",
  "description": "Rejuvenate backend API — Express + TypeScript modular monolith",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "connect-pg-simple": "10.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csv-stringify": "^6.7.0",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "express-rate-limit": "7.4.1",
    "express-session": "1.19.0",
    "file-type": "^18.7.0",
    "helmet": "8.0.0",
    "multer": "^2.1.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "sanitize-html": "2.17.4",
    "sharp": "^0.34.5",
    "zod": "3.24.1"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "@eslint/plugin-kit": "0.3.4"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/connect-pg-simple": "7.0.3",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.0",
    "@types/multer": "^2.1.0",
    "@types/node": "22.10.5",
    "@types/sanitize-html": "2.16.1",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "7.2.0",
    "eslint": "9.18.0",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "prisma": "5.22.0",
    "supertest": "7.2.2",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "4.1.8"
  }
}
