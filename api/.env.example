# Copy this file to `.env` and fill in real values for your environment.
# NEVER commit `.env` (it is gitignored). NEVER commit real secrets to version control.

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database (Postgres 16 — see docker-compose.yml for local dev) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://rejuvenate:rejuvenate@localhost:5432/rejuvenate_dev?schema=public"

# --- Sessions (ADR-0002: server-side sessions in Postgres via connect-pg-simple) ---
# Generate a long random value, e.g.: `openssl rand -base64 48`
# Rotating this invalidates all existing sessions.
SESSION_SECRET=replace-with-a-long-random-string-never-commit-the-real-value

# --- Outbound email (registration confirmations, password resets, etc.) ---
# Fill in with real SMTP relay credentials for your environment (e.g. a transactional
# email provider). Leave blank in local dev if email sending is stubbed/disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Rejuvenate <no-reply@example.org>"

# --- Uploads (ADR-0004: local filesystem storage, see api/.gitignore for the warning) ---
# MUST be an absolute path OUTSIDE this repo checkout in any deployed environment, so
# `git pull` / `npm run build` can never delete or overwrite user-uploaded media.
# Example production value: /var/www/rejuvenate/uploads
UPLOADS_DIR=./uploads
